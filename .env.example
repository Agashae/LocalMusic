# Copiez ce fichier en ".env" et renseignez vos identifiants.
# Créez une app sur https://developer.spotify.com/dashboard pour obtenir
# un Client ID / Client Secret, et ajoutez l'URI de redirection ci-dessous
# dans les paramètres de votre app Spotify.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optionnel : si YouTube renvoie des erreurs 403 Forbidden, vous pouvez
# fournir vos cookies YouTube (extraits automatiquement d'un navigateur
# où vous êtes connecté) pour débloquer le téléchargement.
# Valeurs possibles : chrome, firefox, edge, brave, opera, safari...
# YTDLP_COOKIES_FROM_BROWSER=chrome
